# Blackfin 32-bit instructions
#
# Encodings from the Blackfin Processor Programming Reference, Rev. 2.2,
# appendix C.  The first instruction word is bits 31..16, the second
# bits 15..0.  Bit 27 (M) of the DSP classes marks a multi-issue
# instruction; the translator looks at it, the patterns ignore it.
#
# SPDX-License-Identifier: GPL-2.0-or-later

{
  MNOP          1100 -000 0000 0011  0001 1000 0000 0000
  dsp32mac      1100 - 00 mmod:4 mm:1 p:1 w1:1 op1:2 \
                h01:1 h11:1 w0:1 op0:2 h00:1 h10:1 dst:3 src0:3 src1:3
}
dsp32mult       1100 - 01 mmod:4 mm:1 p:1 w1:1 op1:2 \
                h01:1 h11:1 w0:1 op0:2 h00:1 h10:1 dst:3 src0:3 src1:3
dsp32alu        1100 - 10 000 hl:1 aopcde:5 \
                aop:2 s:1 x:1 dst0:3 dst1:3 src0:3 src1:3
dsp32shift      1100 - 110 0 -- sopcde:5 \
                sop:2 hls:2 dst0:3 000 src0:3 src1:3
dsp32shiftimm   1100 - 110 1 -- sopcde:5 \
                sop:2 hls:2 dst0:3 immag:s6 src1:3

LoopSetup       1110 0000 1 rop:2 c:1 soffset:4  reg:4 00 eoffset:10
LDIMMhalf       1110 0001 z:1 h:1 s:1 grp:2 reg:3  hword:16
CALLa           1110 001 s:1 msw:s8  lsw:16
LDSTidxI        1110 01 w:1 z:1 sz:2 ptr:3 reg:3  offset:s16
linkage         1110 1000 0000 000 r:1  framesize:16

